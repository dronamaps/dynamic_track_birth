FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl ca-certificates coreutils util-linux \
    && rm -rf /var/lib/apt/lists/*

ENV HOST=0.0.0.0 \
    PORT=3000

COPY package.json package-lock.json .npmrc ./
COPY scripts ./scripts
RUN npm run install:ci

COPY app ./app
COPY build ./build
COPY db ./db
COPY drizzle ./drizzle
COPY .openai ./.openai
COPY public ./public
COPY tests ./tests
COPY worker ./worker
COPY drizzle.config.ts eslint.config.mjs next.config.ts postcss.config.mjs tsconfig.json vite.config.ts ./

RUN npm run build

ENV NODE_ENV=production

EXPOSE 3000
CMD ["npm", "run", "start"]
